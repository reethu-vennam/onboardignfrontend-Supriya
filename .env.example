# Frontend-only example. Backend settings live in `backend-spring/.env.example`
# and `backend-spring-admin/.env.example`.

# Google Vision API (for document scanning)
VITE_GOOGLE_VISION_API_KEY=your_google_vision_api_key

# API Configuration
VITE_API_URL=https://onboardingbckend.sabbpe.com
# Optional override for integration-cost lookup (defaults to VITE_API_URL)
VITE_INTEGRATION_COST_API_URL=https://onboardingbckend.sabbpe.com
VITE_SUPPORT_API_URL=https://support-api.example.com
VITE_API_BASE_URL=https://cams.sabbpe.com

# UPI Mandate URLs
VITE_REDIRECT_URL=https://api.example.com/upimandate/callback
VITE_DEBIT_URL=https://api.example.com/upimandate/debit/callback
VITE_MANDATE_CREATE_URL=https://api.example.com/mandatecreate
VITE_MANDATE_STATUS_URL=https://api.example.com/mandatestatus
VITE_VALID_VPA_URL=https://api.example.com/validvpa
VITE_MANDATE_AUTHORIZE=Y

# Payment Gateway Configuration
VITE_PAYMENT_API_URL=https://payment.example.com/api/v1


# latest payment related config (use these for payment integration)
VITE_SABBPE_BASE_URL=https://pymntsuat.sabbpe.com
VITE_FRONTEND_URL=onboardinguat.sabbpe.com
VITE_SABBPE_USER_ID=your_sabbpe_user_id
VITE_SABBPE_MERCHANT_ID=your_sabbpe_merchant_id
VITE_SABBPE_PASSWORD=your_sabbpe_password
VITE_SABBPE_PRODUCT_INFO=Test
VITE_SABBPE_CUSTOMER_FIRSTNAME=Customer
VITE_SABBPE_CUSTOMER_EMAIL=customer@example.com
VITE_SABBPE_CUSTOMER_PHONE=9999999999

# Transbank API Configuration
VITE_TRANSBANK_BASE_URL=https://transbankuat.sabbpe.com/api
VITE_TRANSBANK_CLIENT_ID=your_transbank_client_uuid
VITE_TRANSBANK_ENTITY_ID=your_transbank_entity_uuid
VITE_TRANSBANK_PROGRAM_ID=your_program_id
VITE_TRANSBANK_PROCESSOR=TRANSBANK
VITE_TRANSBANK_TRANSACTION_TYPE=IMPS

