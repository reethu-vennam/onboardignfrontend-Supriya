# Backend-only example. Frontend settings live in `../.env.example`.

PORT=8888
NODE_ENV=development

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=your_jwt_secret

BANK_API_URL=https://bank-api.example.com
BANK_API_KEY=your_bank_api_key

WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_API_KEY=your_webhook_api_key

API_BASE_URL=https://api.example.com
VITE_FRONTEND_URL=https://frontend.example.com

ADMIN_EMAIL=admin@example.com
# Internal email for bank final-approval documents ZIP (NOT sent to merchant)
FINAL_APPROVAL_DOCUMENTS_EMAIL=vendor.onboarding@sabbpe.com
NOTIFICATIONS_ENGINE_URL=https://notifications.sabbpe.com
NOTIFICATIONS_ENGINE_MAIL_PATH=/api/mail/merchant-notify
NOTIFICATIONS_ENGINE_ALLOW_SMTP_FALLBACK=true
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password_or_app_password
EMAIL_FROM=your_verified_sender@example.com
LOG_LEVEL=DEBUG
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

MSG91_AUTHKEY=your_msg91_authkey
MSG91_INTEGRATED_NUMBER=your_msg91_integrated_number
MSG91_WHATSAPP_URL=https://api.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/
MSG91_SMS_FLOW_URL=https://control.msg91.com/api/v5/flow
MSG91_INVITE_TEMPLATE=merchantinv
MSG91_INVITE_NAMESPACE=merchant_onboarding
MSG91_SMS_TEMPLATE_ID=your_sms_template_id
MSG91_TEMPLATE_NAME=ekyc_verification
MSG91_NAMESPACE=

# Sahil Chatbot - Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3-flash,gemini-2.5-flash,gemini-2.5-flash-lite
